{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "pnpm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "dashboardius": {
      "projectType": "application",
      "schematics": { "@schematics/angular:component": { "style": "scss" } },
      "root": "",
      "sourceRoot": "src",
      "prefix": "db",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "outputPath": "dist/dashboardius",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "index": "src/index.html",
            "assets": [
              { "glob": "**/*", "input": "public" }
            ],
            "styles": ["src/styles.scss"],
            "baseHref": "/",
            "security": {
              "allowedHosts": ["dashboardius.com", "www.dashboardius.com", "localhost", "127.0.0.1"]
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "860kB", "maximumError": "940kB" },
                { "type": "anyComponentStyle", "maximumWarning": "34kB", "maximumError": "40kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "dashboardius:build:production" },
            "development": { "buildTarget": "dashboardius:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  }
}
