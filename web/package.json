{
  "name": "@dashboardius/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/write-primeui-license.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "verify": "pnpm test && pnpm build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "generate:palette": "node scripts/generate-primeng-palette.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "prebuild": "node scripts/write-primeui-license.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/ssr": "22.1.5",
    "@primeuix/themes": "3.0.0",
    "ag-grid-community": "36.1.0",
    "chart.js": "4.5.0",
    "firebase": "12.10.0",
    "primeng": "22.1.0",
    "rxjs": "7.8.2",
    "tabulator-tables": "6.5.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@playwright/test": "1.55.1",
    "@types/node": "24.13.3",
    "@types/tabulator-tables": "6.3.6",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
