{
  "name": "@dashboardius/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/write-primeui-license.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "verify": "pnpm test && pnpm build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "generate:palette": "node scripts/generate-primeng-palette.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "prebuild": "node scripts/write-primeui-license.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "22.1.8",
    "@primeuix/themes": "3.0.1",
    "ag-grid-community": "36.2.0",
    "chart.js": "4.5.1",
    "firebase": "12.19.0",
    "primeng": "22.1.1",
    "rxjs": "7.8.2",
    "tabulator-tables": "6.5.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/tabulator-tables": "6.3.6",
    "jsdom": "28.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
