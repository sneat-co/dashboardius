{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboardius",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,

  // Assets-only: no `main`, so static requests never invoke a Worker (free and
  // unlimited). Unknown paths get the SPA shell with a 200 at the requested URL
  // (the app routes them to the board). Security and cache headers live in
  // public/_headers. `/__/auth/*` (Firebase auth handler) is served by the
  // `sneat-firebase-auth-proxy` zone route, not by this Worker.
  "assets": {
    "directory": "./dist/dashboardius/browser",
    "not_found_handling": "single-page-application"
  },

  // APEX CUSTOM DOMAIN. Cloudflare manages the proxied DNS record and the TLS
  // certificate. Attaching a custom domain needs a token with Zone:DNS:Edit —
  // a Workers-only token cannot create one — so this is a one-time dashboard
  // step; after that CI keeps the Worker in sync. `www` is deliberately NOT a
  // second custom domain (that would serve duplicate content); a zone Single Redirect
  // rule 301s it to the apex instead.
  "routes": [{ "pattern": "dashboardius.com", "custom_domain": true }]
}
